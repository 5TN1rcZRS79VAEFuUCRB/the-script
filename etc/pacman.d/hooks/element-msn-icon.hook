# Element draws its window and tray icon from its own build/icon.png, not the icon theme, so the
# Windows Live Messenger icon (the-script's Element icon) is copied over it after each update.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = element-desktop
Target = aerothemeplasma-icons-git

[Action]
Description = Giving Element the Windows Live Messenger icon...
When = PostTransaction
Exec = /bin/sh -c 'f="/usr/share/icons/Windows 7 Aero/actions/32/im-msn.png"; if [ -e "$f" ] && [ -d /usr/lib/element/build ]; then cp "$f" /usr/lib/element/build/icon.png; fi'
