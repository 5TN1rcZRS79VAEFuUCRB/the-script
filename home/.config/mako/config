# the-script: notifications (mako), square and dark, top right under the bar.
font=Adwaita Sans 11
background-color=#1b1b1bf2
text-color=#ffffff
border-color=#3d3d3d
border-size=1
border-radius=0
padding=12
margin=8
outer-margin=4
width=380
height=200
icons=1
max-icon-size=40
icon-path=/usr/share/icons/Adwaita
anchor=top-right
layer=overlay
default-timeout=8000
max-visible=4
format=<b>%s</b>\n%b

[urgency=critical]
border-color=#e01b24
default-timeout=0

[app-name=todo]
border-color=#3584e4
