#!/usr/bin/env python3
"""
bedtime: computers are off from 9:30 PM to 6:30 AM, every day, an hour of no screens before a 10:30 PM
bedtime and a 6:30 AM wake-up.

Warns 15, 5 and 1 minute before 9:30 PM, then shuts the computer down. Turned on (or woken from sleep)
between 9:30 PM and 6:30 AM, it warns once and shuts down a minute later. No snooze.

Started with the desktop session by bedtime.service. Never on arch-server: a server stays on. For a
test run, BEDTIME_OFF=HH:MM and BEDTIME_ON=HH:MM move the times, and BEDTIME_DRY_RUN=1 notifies
instead of shutting down.
"""
import datetime as dt
import math
import os
import subprocess
import time


def hhmm(var, default):
    h, m = os.environ.get(var, default).split(":")
    return dt.time(int(h), int(m))


OFF = hhmm("BEDTIME_OFF", "21:30")
ON = hhmm("BEDTIME_ON", "06:30")
DRY_RUN = os.environ.get("BEDTIME_DRY_RUN") == "1"
WARN_MINUTES = (15, 5, 1)
GRACE = dt.timedelta(minutes=1)


def clock(t):
    return t.strftime("%-I:%M %p")


def notify(title, body, critical=False):
    subprocess.run(["notify-send", "-a", "Bedtime", "-i", "system-shutdown",
                    "-u", "critical" if critical else "normal", title, body],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def in_lockout(t):
    return t >= OFF or t < ON if OFF > ON else OFF <= t < ON


def poweroff():
    if DRY_RUN:
        notify("Bedtime (dry run)", "The computer would shut down now.", critical=True)
        return
    # As root so a program holding off shutdown (a game, a download) can't stop it.
    if subprocess.run(["sudo", "-n", "systemctl", "poweroff", "--ignore-inhibitors"]).returncode != 0:
        subprocess.run(["systemctl", "poweroff"])


def main():
    if open("/etc/hostname").read().strip() == "arch-server":
        return
    window = f"Computers are off from {clock(OFF)} to {clock(ON)}."
    warned = set()      # (date, minutes) already warned about
    deadline = None     # when to shut down, once inside the off hours
    while True:
        now = dt.datetime.now()
        off_today = dt.datetime.combine(now.date(), OFF)
        if in_lockout(now.time()):
            if deadline is None:
                if (now.date(), 1) in warned and now - off_today < dt.timedelta(minutes=5):
                    deadline = off_today      # the 1-minute warning already went out
                else:
                    deadline = now + GRACE
                    notify("Bedtime: shutting down in 1 minute", window, critical=True)
            if now >= deadline:
                poweroff()
                deadline = now + GRACE        # try again in a minute if it didn't go through
        else:
            deadline = None
            left = (off_today - now).total_seconds() / 60
            due = [m for m in WARN_MINUTES if left <= m and (now.date(), m) not in warned]
            if due:
                warned.update((now.date(), m) for m in WARN_MINUTES if m >= min(due))
                mins = max(1, math.ceil(left))
                notify(f"Bedtime: shutting down at {clock(OFF)}",
                       f"In {mins} minute{'s' if mins != 1 else ''}. Save what you're working on. {window}",
                       critical=min(due) <= 5)
        time.sleep(10)


if __name__ == "__main__":
    main()
