#!/usr/bin/env python3
"""
mouse-dpi [cm]: measures a mouse's real DPI. Slide it along a ruler (10 cm unless given) three times;
the raw counts the sensor sent over that distance are its actual DPI, which can be a few percent off
the DPI it is set to. Two mice set to the same DPI then show whether one really moves the cursor
further. Next to it is the set DPI, read from a Razer or Endgame Gear mouse.

Reading /dev/input needs root, so it restarts itself with sudo. The cursor moves as usual meanwhile.
"""
import fcntl
import glob
import math
import os
import select
import struct
import sys
import time

ROUNDS = 3
EVENT = struct.Struct("llHHi")  # struct input_event: time, type, code, value
EV_REL, REL_X, REL_Y = 2, 0, 1


# DPI as the mouse itself reports it over hidraw. Razer: Razer's 90-byte feature report, get DPI =
# class 0x04, id 0x85. Endgame Gear 8k (OP1 8k v2 etc.): LOAD (0x12) on report 0xA1, then report
# 0xA0 returns the 1024-byte settings block at offset 16 (layout from github.com/Janlhin/
# Endgame_Gear_Web_Configurator). Both are read-only. None for other mice or a sleeping wireless one.
def feature(n, size):
    return (3 << 30) | (size << 16) | (ord('H') << 8) | n  # HIDIOCSFEATURE(6)/HIDIOCGFEATURE(7)


def dpi_text(x, y):
    return str(x) if x == y else f"{x}x{y}"


def razer(fd):
    for tid in (0x1f, 0x3f, 0xff):  # transaction id differs between Razer models
        r = bytearray(91)  # report number 0, then the 90-byte report
        r[2], r[6], r[7], r[8] = tid, 0x07, 0x04, 0x85
        for b in r[3:89]:
            r[89] ^= b
        fcntl.ioctl(fd, feature(6, 91), bytes(r))
        time.sleep(0.06)
        fcntl.ioctl(fd, feature(7, 91), r)
        if r[1] == 0x02 and r[7:9] == b'\x04\x85':  # status 2 = ok
            return dpi_text(r[10] << 8 | r[11], r[12] << 8 | r[13])


def endgame(fd):
    cmd = bytearray(64)
    cmd[0], cmd[1] = 0xA1, 0x12
    fcntl.ioctl(fd, feature(6, 64), bytes(cmd))
    for _ in range(5):
        time.sleep(0.08)
        r = bytearray(1041)
        r[0] = 0xA0
        fcntl.ioctl(fd, feature(7, 1041), r)
        b = r[16:]
        if r[1] == 0x01 and b[0x0D] < b[0x0E] <= 4:  # status 1 = ok; active stage < stage count
            o = 0x23 + 5 * b[0x0D]  # per stage: [separate Y flag][X u16 LE][Y u16 LE]
            x = b[o + 1] | b[o + 2] << 8
            return dpi_text(x, b[o + 3] | b[o + 4] << 8 if b[o] else x)


def set_dpi():
    for node in glob.glob('/sys/class/hidraw/hidraw*'):
        try:
            uevent = open(node + '/device/uevent').read()
            if ':00001532:' in uevent:
                read = razer
            elif ':00003367:' in uevent and b'\x85\xa0' in open(node + '/device/report_descriptor', 'rb').read():
                read = endgame  # only the interface that has the config reports
            else:
                continue
            fd = os.open('/dev/' + os.path.basename(node), os.O_RDWR)
            try:
                found = read(fd)
            finally:
                os.close(fd)
            if found:
                return found
        except OSError:
            continue  # no access, or not the control interface


def mice():
    # One mouse can have several event nodes (Razer's -if01- one too); counts from all of them add up.
    found = {}
    for link in sorted(glob.glob("/dev/input/by-id/*-event-mouse")):
        name = os.path.basename(link).removeprefix("usb-").split("-event-mouse")[0]
        name = name.split("-if")[0].replace("_", " ")
        found.setdefault(name, []).append(os.path.realpath(link))
    return found


def wait_enter(fds, counts):
    # Adds up movement per mouse until Enter is pressed.
    while True:
        ready, _, _ = select.select([sys.stdin, *fds], [], [])
        for fd in ready:
            if fd is sys.stdin:
                sys.stdin.readline()
                return
            data = os.read(fd, EVENT.size * 64)
            for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, kind, code, value = EVENT.unpack_from(data, i)
                if kind == EV_REL and code in (REL_X, REL_Y):
                    counts[fds[fd]][code] += value


def main():
    cm = float(sys.argv[1]) if len(sys.argv) > 1 else 10.0
    found = mice()
    if not found:
        sys.exit("mouse-dpi: no mouse found")
    fds = {}
    try:
        for name, nodes in found.items():
            for node in nodes:
                fds[os.open(node, os.O_RDONLY | os.O_NONBLOCK)] = name
    except PermissionError:
        os.execvp("sudo", ["sudo", sys.executable, os.path.abspath(__file__), *sys.argv[1:]])

    configured = set_dpi()
    results = []
    print(f"Lay a ruler on the mousepad and slide the mouse exactly {cm:g} cm along it, {ROUNDS} times.")
    for n in range(1, ROUNDS + 1):
        input(f"\n{n}/{ROUNDS}: line the mouse's edge up with 0 and press Enter.")
        counts = {name: [0, 0] for name in found}
        print(f"     Slide it to {cm:g} cm, then press Enter.", end="", flush=True)
        wait_enter(fds, counts)
        name, (x, y) = max(counts.items(), key=lambda c: math.hypot(*c[1]))
        dpi = math.hypot(x, y) / (cm / 2.54)
        results.append((name, dpi))
        print(f"     {name}: {math.hypot(x, y):.0f} counts = {dpi:.0f} DPI")

    name = results[-1][0]
    dpis = [d for n, d in results if n == name]
    average = sum(dpis) / len(dpis)
    spread = max(dpis) - min(dpis)
    print(f"\n{name}: {average:.0f} DPI measured (rounds within {spread:.0f} of each other)", end="")
    if configured and "x" not in configured:
        print(f", set to {configured} ({(average / int(configured) - 1) * 100:+.1f}%)")
    else:
        print()
    if spread > average * 0.03:
        print("The rounds differ by more than 3%: slide along the ruler's edge and stop exactly on the mark.")


try:
    main()
except KeyboardInterrupt:
    print()
