#!/usr/bin/env python3
"""
presence: tells arch-server once a minute how long this computer has gone without input, and whether
something (a video, a fullscreen game) is holding off the idle screen. presence-collector there works
out from that when you go to bed and get up (on arch-server: presence-collector report).

Started with the Plasma session by presence.service. Pings that can't be sent (server or network down)
wait in ~/.local/state/presence/queue and go out later, up to a week's worth.
"""
import os
import subprocess
import threading
import time
import urllib.error
import urllib.request

SERVER = "http://arch-server:8787"
QUEUE = os.path.expanduser("~/.local/state/presence/queue")
KEEP = 7 * 24 * 60
DEVICE = open("/etc/hostname").read().strip()


def gdbus(dest, path, method, *args):
    out = subprocess.run(["gdbus", "call", "--session", "--dest", dest, "--object-path", path,
                          "--method", method, *args], capture_output=True, text=True, timeout=10)
    return out.stdout.strip() if out.returncode == 0 else None


class Idle:
    """Watches for input through swayidle (KWin's idle protocol; Plasma has no idle time on D-Bus under
    Wayland): it says "idle" a second after the last input and "active" at the next one. While an app
    holds off the idle screen it never says "idle", which the inhibit flag covers anyway."""

    def __init__(self):
        self.since = None       # when input stopped, or None while in use
        self.proc = subprocess.Popen(["swayidle", "timeout", "1", "echo idle", "resume", "echo active"],
                                     stdout=subprocess.PIPE, text=True)
        threading.Thread(target=self.watch, daemon=True).start()

    def watch(self):
        for line in self.proc.stdout:
            self.since = time.time() - 1 if line.strip() == "idle" else None

    def seconds(self):
        """Seconds since the last input; None if swayidle has stopped (no session)."""
        if self.proc.poll() is not None:
            return None
        return int(time.time() - self.since) if self.since else 0


def reading(idle):
    """Seconds since the last input, and 1 if idle is being held off; None outside a Plasma session."""
    secs = idle.seconds()
    if secs is None:
        return None
    inhibit = gdbus("org.kde.Solid.PowerManagement.PolicyAgent", "/org/kde/Solid/PowerManagement/PolicyAgent",
                    "org.kde.Solid.PowerManagement.PolicyAgent.HasInhibition", "4")  # 4: screen dimming/off
    return secs, int(inhibit == "(true,)")


def main():
    os.makedirs(os.path.dirname(QUEUE), exist_ok=True)
    try:
        with open(QUEUE) as f:
            queue = f.read().split()
    except FileNotFoundError:
        queue = []
    saved = bool(queue)
    idle = Idle()
    while True:
        r = reading(idle)
        if r:
            queue.append(f"{SERVER}/ping?d={DEVICE}&idle={r[0]}&inhibit={r[1]}&t={int(time.time())}")
        sent = 0
        for url in queue:
            try:
                urllib.request.urlopen(url, timeout=10).close()
            except urllib.error.HTTPError:
                pass                    # the server turned it down: retrying won't help
            except OSError:
                break
            sent += 1
        queue = queue[sent:][-KEEP:]
        if queue or saved:              # an empty queue is written once, not every minute
            with open(QUEUE + ".tmp", "w") as f:
                f.write("\n".join(queue))
            os.replace(QUEUE + ".tmp", QUEUE)
            saved = bool(queue)
        time.sleep(60)


if __name__ == "__main__":
    main()
