#!/usr/bin/env bash
#
# screenshot: save a screenshot of the whole screen without a dialog (grim).
#
#   screenshot [FILE]   save to FILE (default: ./screenshot-<time>.png) and print its path

set -euo pipefail

dest=$(realpath -m "${1:-screenshot-$(date +%Y%m%d-%H%M%S).png}")
grim "$dest"
[ -s "$dest" ] || { echo "screenshot: grim saved nothing" >&2; exit 1; }
echo "$dest"
