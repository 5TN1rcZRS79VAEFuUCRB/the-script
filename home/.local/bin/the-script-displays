#!/usr/bin/env python3
"""the-script-displays: set up the screens at login and when one is plugged in (Hyprland runs it).

For each connected screen: its scale and position as KWin last had them (~/.config/kwinoutputconfig.json,
left from Plasma), or else 1.5 at 4K and 1.25 on a laptop's own screen; and its largest resolution at
the fastest refresh rate (a 144 Hz monitor can come up at 60). Changes nothing that is already right.
The result goes to ~/.config/hypr/monitors.lua, which hyprland.lua loads, and Hyprland reloads its
config when that file changes. To keep a different scale, put an hl.monitor({...}) line for that screen
in ~/.config/hypr/local.lua (loaded after monitors.lua), or change the numbers below.
"""
import json
import os
import re
import subprocess


def kwin_settings():
    try:
        cfg = {s["name"]: s["data"] for s in json.load(open(os.path.expanduser("~/.config/kwinoutputconfig.json")))}
    except (OSError, ValueError, KeyError, TypeError):
        return {}
    out = {}
    for setup in cfg.get("setups", []):
        if setup.get("lidClosed"):
            continue
        for o in setup.get("outputs", []):
            if not o.get("enabled"):
                continue
            d = cfg["outputs"][o["outputIndex"]]
            out.setdefault(d.get("connectorName"), {"scale": d.get("scale", 1), "pos": o.get("position")})
    return out


def modes(m):
    for s in m.get("availableModes", []):
        r = re.match(r"(\d+)x(\d+)@([\d.]+)Hz", s)
        if r:
            yield int(r[1]), int(r[2]), float(r[3])


def main():
    mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, check=True).stdout)
    kwin = kwin_settings()
    lines = ["-- Written by the-script-displays at login and when a screen is plugged in; don't edit."]
    x = 0
    for m in sorted(mons, key=lambda m: m["x"]):
        name = m["name"]
        ms = list(modes(m)) or [(m["width"], m["height"], m["refreshRate"])]
        w, h, hz = max(ms, key=lambda t: (t[0] * t[1], t[2]))
        k = kwin.get(name)
        if k:
            scale = k["scale"]
        elif w >= 3840:
            scale = 1.5
        elif name.startswith("eDP"):
            scale = 1.25
        else:
            scale = 1
        pos = f'{k["pos"]["x"]}x{k["pos"]["y"]}' if k and k.get("pos") else f"{x}x0"
        x += round(w / scale)
        lines.append(f'hl.monitor({{ output = "{name}", mode = "{w}x{h}@{hz:.3f}", position = "{pos}", scale = {scale:g} }})')
    path = os.path.expanduser("~/.config/hypr/monitors.lua")
    text = "\n".join(lines) + "\n"
    try:
        if open(path).read() == text:
            return
    except OSError:
        pass
    with open(path + ".tmp", "w") as f:
        f.write(text)
    os.replace(path + ".tmp", path)
    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
