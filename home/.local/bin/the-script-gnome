#!/usr/bin/env bash
#
# the-script-gnome: GNOME settings, run by install.sh and at every login
# (~/.config/autostart/the-script-gnome.desktop). Each step checks first, so a run where everything is
# in place changes nothing.
#
#   - first run only: dark style for apps, a red accent (the ThinkPad colors in ~/.config/gtk-4.0/gtk.css
#     use it too) and the ThinkPad wallpaper
#   - the AppIndicator extension (tray icons for Steam, Discord, Syncthing, KeePassXC) and the to-do
#     extension turned on
#   - gray folder icons (Adwaita-ThinkPad, made by install.sh)
#   - once: the app grid sorted into folders (Chat, Internet, Media, Development, System) and the dash
#   - screenshots through the portal without a dialog, for apps outside Flatpak (screenshot)
#   - once, on machines that had KDE: the installer is run again from GNOME to remove Plasma, which it
#     could not do with Plasma running

set -uo pipefail

STATE="$HOME/.local/state"
FIRST="$STATE/the-script-gnome-first-run"
KDE_PENDING="$STATE/the-script-kde-pending"
EXTENSIONS=(appindicatorsupport@rgcjonas.gmail.com todo@the-script)

# gsettings without a session bus writes to memory and drops it.
[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || { echo "the-script-gnome: no session bus; settings not applied" >&2; exit 1; }
gsettings list-schemas | grep -qx org.gnome.shell || { echo "the-script-gnome: GNOME Shell is not installed" >&2; exit 1; }

# Adds items to a string-list setting, keeping what is there.
add_to_list() { # schema key items...
	local schema=$1 key=$2; shift 2
	local new
	new=$(python3 -c 'import ast, sys
cur = ast.literal_eval(sys.argv[1].removeprefix("@as "))
add = [i for i in sys.argv[2:] if i not in cur]
print(repr(cur + add) if add else "")' "$(gsettings get "$schema" "$key")" "$@")
	[ -z "$new" ] || gsettings set "$schema" "$key" "$new"
}

if [ ! -e "$FIRST" ]; then
	gsettings set org.gnome.desktop.interface color-scheme prefer-dark
	gsettings set org.gnome.desktop.interface accent-color red
	# The ThinkPad wordmark with its red i-dot on matte black (~/.local/share/backgrounds), in light style too.
	bg="file://$HOME/.local/share/backgrounds/thinkpad.svg"
	if [ -e "${bg#file://}" ]; then
		for k in "background picture-uri" "background picture-uri-dark" "screensaver picture-uri"; do
			gsettings set org.gnome.desktop.${k% *} ${k#* } "$bg"
		done
	fi
	mkdir -p "$STATE" && touch "$FIRST"
fi

gsettings set org.gnome.shell disable-user-extensions false
add_to_list org.gnome.shell enabled-extensions "${EXTENSIONS[@]}"

# Once: the app grid sorted into folders, everyday apps first, and the same everyday apps in the dash.
# Apps a machine lacks are skipped; anything new lands after these. Rearranging by hand is kept.
if [ ! -e "$STATE/the-script-gnome-app-folders" ]; then
	python3 - <<-'EOF' && touch "$STATE/the-script-gnome-app-folders"
	import subprocess

	TOP = ["firefox", "org.gnome.Nautilus", "org.gnome.Console", "org.gnome.TextEditor", "steam", "anki",
	       "org.keepassxc.KeePassXC", "org.gnome.Settings"]
	DASH = ["firefox", "org.gnome.Nautilus", "org.gnome.Console", "io.element.Element", "discord", "steam", "anki"]
	FOLDERS = {
	    "Chat": ["io.element.Element", "discord", "weechat"],
	    "Internet": ["chromium", "org.torproject.torbrowser-launcher", "proton.vpn.app.gtk"],
	    "Media": ["mpv", "com.obsproject.Studio", "org.gnome.Loupe"],
	    "Development": ["nvim", "cmake-gui", "vmware-workstation", "vmware-netcfg", "btop"],
	    "System": ["cups", "system-config-printer", "org.freedesktop.IBus.Setup", "org.gnome.ColorProfileViewer",
	               "qt5ct", "qt6ct", "avahi-discover", "bssh", "bvnc", "xgps", "xgpsspeed", "qv4l2", "qvidcap",
	               "the-script-update", "org.torproject.torbrowser-launcher.settings"],
	}


	def gset(schema, key, value):
	    subprocess.run(["gsettings", "set", schema, key, value], check=True)


	def strv(items):
	    return "[" + ", ".join(repr(i) for i in items) + "]"


	for name, apps in FOLDERS.items():
	    schema = f"org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/{name}/"
	    gset(schema, "name", repr(name))
	    gset(schema, "apps", strv(f"{a}.desktop" for a in apps))
	    gset(schema, "categories", "@as []")
	    gset(schema, "translate", "false")
	gset("org.gnome.desktop.app-folders", "folder-children", strv(FOLDERS))
	order = [f"{a}.desktop" for a in TOP] + list(FOLDERS)
	gset("org.gnome.shell", "app-picker-layout",
	     "[{" + ", ".join(f"{i!r}: <{{'position': <{n}>}}>" for n, i in enumerate(order)) + "}]")
	gset("org.gnome.shell", "favorite-apps", strv(f"{a}.desktop" for a in DASH))
	EOF
fi

# Gray folders (the Adwaita-ThinkPad icons install.sh makes), unless another icon theme was picked.
if [ -e "$HOME/.local/share/icons/Adwaita-ThinkPad/index.theme" ] \
	&& [ "$(gsettings get org.gnome.desktop.interface icon-theme)" = "'Adwaita'" ]; then
	gsettings set org.gnome.desktop.interface icon-theme Adwaita-ThinkPad
fi

# Apps outside Flatpak may take screenshots through the portal without a dialog (~/.local/bin/screenshot).
# They run as you anyway; Flatpak apps still ask.
gdbus call --session -d org.freedesktop.impl.portal.PermissionStore -o /org/freedesktop/impl/portal/PermissionStore \
	-m org.freedesktop.impl.portal.PermissionStore.SetPermission screenshot true screenshot '' "['yes']" >/dev/null

# install.sh leaves Plasma installed while a Plasma session runs. In GNOME, clearing the installed
# commit makes the updater run it again now, and that run removes Plasma.
if [ -e "$KDE_PENDING" ] && [ "${XDG_CURRENT_DESKTOP:-}" = GNOME ] && ! pgrep -x plasmashell >/dev/null; then
	rm -f "$STATE/the-script-installed"
	systemctl --user start --no-block the-script-update.service
fi
