#!/usr/bin/env bash
#
# the-script-plasma: the Windows 7 desktop settings that need a running Plasma session, run at every
# login (~/.config/autostart/the-script-plasma.desktop). Each step checks first, so a login where
# everything is in place changes nothing.
#
#   - first login only: the Windows 7 theme with dark apps (authui7-dark, made by install.sh), the
#     Windows 7 wallpaper, and on a desktop variable refresh rate always on (games included)
#   - once, on machines that had niri: each monitor's scale from niri's local.kdl
#   - the Windows key opens the Start orb's menu (SevenStart), not Plasma's launcher (Alt+F1)
#   - the todo widget on the taskbar left of the tray, opened by Meta+T

set -uo pipefail

STATE="$HOME/.local/state"
FIRST="$STATE/the-script-plasma-first-login"
NIRI_SCALE="$STATE/the-script-plasma-niri-scale"
WALLPAPER="$HOME/.local/share/wallpapers/windows7-harmony.jpg"
APPLETSRC="$HOME/.config/plasma-io.gitgud.wackyideas.desktop-appletsrc"

js() { qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$1"; }
# kglobalaccel keys are Qt key codes: Meta 16777250, Ctrl+Esc 83886080, Alt+F1 150994992.
keys() { # component action keys...
	local c=$1 a=$2; shift 2
	local list; list=$(printf '([%s],),' "$@"); list="[${list%,}]"
	[ $# -gt 0 ] || list="@a(ai) []"
	gdbus call --session -d org.kde.kglobalaccel -o /kglobalaccel \
		-m org.kde.KGlobalAccel.setForeignShortcutKeys "['$c','$a','','']" "$list" >/dev/null
}

# The panel is made on the first start of the shell; wait for it (and its Start orb).
wait_start() {
	for _ in $(seq 60); do
		start=$(js 'var p = panels()[0]; var s = p ? p.widgets("io.gitgud.wackyideas.SevenStart")[0] : null; print(s ? s.id : "");' 2>/dev/null)
		[ -n "$start" ] && return
		sleep 1
	done
	echo "the-script-plasma: no panel with the Start orb" >&2; exit 1
}
wait_start

# Only marked done once the theme applies, so a login before install.sh made authui7-dark retries.
if [ ! -e "$FIRST" ] && plasma-apply-lookandfeel -a authui7-dark; then
	[ -e "$WALLPAPER" ] && plasma-apply-wallpaperimage "$WALLPAPER"
	if ! compgen -G '/sys/class/power_supply/BAT*' >/dev/null; then
		for o in $(kscreen-doctor -j | python3 -c 'import json, sys; print(*(o["name"] for o in json.load(sys.stdin)["outputs"] if o.get("connected")))'); do
			kscreen-doctor "output.$o.vrrpolicy.always" >/dev/null
		done
	fi
	mkdir -p "$STATE" && touch "$FIRST"
fi

# Once, on machines that had niri: its per-monitor scale (~/.config/niri/local.kdl), since Plasma
# starts every screen at its own default (1 on the T14, which is too small).
if [ ! -e "$NIRI_SCALE" ] && [ -f "$HOME/.config/niri/local.kdl" ]; then
	awk '$1 == "output" { gsub(/"/, "", $2); o = $2 } $1 == "scale" { print o, $2 }' "$HOME/.config/niri/local.kdl" |
		while read -r o s; do kscreen-doctor "output.$o.scale.$s" >/dev/null; done
	mkdir -p "$STATE" && touch "$NIRI_SCALE"
	# The running shell keeps text rendered for the old scale (uneven, smudged letters) until restarted.
	systemctl --user restart plasma-plasmashell
	wait_start
fi

# Plasma 6 hands a lone Meta press to "activate application launcher", which skips the Start orb.
js "var s = panels()[0].widgets('io.gitgud.wackyideas.SevenStart')[0]; if (!s.globalShortcut) s.globalShortcut = 'Ctrl+Esc';" >/dev/null
keys plasmashell 'activate application launcher' 150994992
keys plasmashell "activate widget $start" 16777250 83886080

# The todo widget. Plasma reads the panel's order only at start, so a new one is moved left of the
# tray with the shell stopped. local.niritodo is its name from before the-script.
if [ -z "$(js 'print(panels()[0].widgets("local.todo").length || "");')" ]; then
	keys kwin 'Edit Tiles'   # Meta+T by default
	read -r panel todo tray ids < <(js 'var p = panels()[0];
		p.widgets("local.niritodo").forEach(function (w) { w.remove(); });
		var w = p.addWidget("local.todo"); w.globalShortcut = "Meta+T";
		var t = p.widgets("io.gitgud.wackyideas.systemtray")[0];
		print(p.id + " " + w.id + " " + (t ? t.id : "") + " " + p.widgetIds.join(";"));')
	if [ -n "$tray" ]; then
		sleep 2   # let the shell save the new widget
		systemctl --user stop plasma-plasmashell
		# A panel never rearranged has no saved order yet: then it is the order the widgets were added in.
		order=$(kreadconfig6 --file "$APPLETSRC" --group Containments --group "$panel" --group General --key AppletOrder)
		order=${order:-$ids}
		order=$(python3 -c 'import sys
o, todo, tray, live = sys.argv[1].split(";"), sys.argv[2], sys.argv[3], sys.argv[4].split(";")
o = [i for i in o if i in live and i != todo]
o.insert(o.index(tray) if tray in o else len(o), todo)
print(";".join(o))' "$order" "$todo" "$tray" "$ids")
		kwriteconfig6 --file "$APPLETSRC" --group Containments --group "$panel" --group General --key AppletOrder "$order"
		systemctl --user start plasma-plasmashell
	fi
fi
