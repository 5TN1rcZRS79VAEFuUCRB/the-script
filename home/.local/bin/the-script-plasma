#!/usr/bin/env bash
#
# the-script-plasma: Plasma settings that need a running session, run at every login
# (~/.config/autostart/the-script-plasma.desktop). Each step checks first, so a login where
# everything is in place changes nothing.
#
#   - first login only: Breeze Dark, and on a desktop variable refresh rate always on (games included)
#   - once: the star trails wallpaper on the desktop and the lock screen, and GNOME's black
#     Adwaita cursor in place of Breeze's
#   - once: the taskbar rebuilt as a floating bar: the launcher with the Arch logo and the task icons
#     on the left, the todo widget, tray and clock on the right
#   - once: the pinned apps set to Settings, Files, Konsole, LibreWolf and Element, in that order
#   - the todo widget on the taskbar left of the tray, opened by Meta+T
#   - your Firefox profile copied into LibreWolf, if install.sh could not do it with a browser open
#   - once, on machines that had GNOME: the installer is run again from Plasma to remove GNOME, which it
#     could not do with GNOME running

set -uo pipefail

STATE="$HOME/.local/state"
FIRST="$STATE/the-script-plasma-breeze"
WALLPAPER="$HOME/.local/share/wallpapers/the-script.jpg"
GNOME_PENDING="$STATE/the-script-remove-gnome"
APPLETSRC="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
# The taskbar's pinned apps. Plasma's own default pins Discover, which the-script doesn't install, so its
# icon was blank.
PINNED=applications:systemsettings.desktop,preferred://filemanager,applications:org.kde.konsole.desktop,preferred://browser,applications:io.element.Element.desktop

js() { qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$1"; }
# kglobalaccel keys are Qt key codes; none clears the shortcut.
keys() { # component action keys...
	local c=$1 a=$2; shift 2
	local list; list=$(printf '([%s],),' "$@"); list="[${list%,}]"
	[ $# -gt 0 ] || list="@a(ai) []"
	gdbus call --session -d org.kde.kglobalaccel -o /kglobalaccel \
		-m org.kde.KGlobalAccel.setForeignShortcutKeys "['$c','$a','','']" "$list" >/dev/null
}

# install.sh copies the Firefox profile into LibreWolf only with both closed; if one was open, it is done
# now, before either is started.
[ -e "$STATE/the-script-librewolf-import-pending" ] && "$HOME/.local/bin/librewolf-import-firefox"

# install.sh leaves GNOME installed while a GNOME session runs. In Plasma, clearing the installed
# commit makes the updater run it again now, and that run removes GNOME.
if [ -e "$GNOME_PENDING" ] && ! pgrep -x gnome-shell >/dev/null; then
	rm -f "$STATE/the-script-installed"
	systemctl --user start --no-block the-script-update.service
fi

# Only marked done once the theme applies.
if [ ! -e "$FIRST" ] && plasma-apply-lookandfeel -a org.kde.breezedark.desktop; then
	if ! compgen -G '/sys/class/power_supply/BAT*' >/dev/null; then
		for o in $(kscreen-doctor -j | python3 -c 'import json, sys; print(*(o["name"] for o in json.load(sys.stdin)["outputs"] if o.get("connected")))'); do
			kscreen-doctor "output.$o.vrrpolicy.always" >/dev/null
		done
	fi
	mkdir -p "$STATE" && touch "$FIRST"
fi

# Once each; changing them afterwards is kept (until the -N in the state file name is bumped).
if [ ! -e "$STATE/the-script-plasma-wallpaper-3" ] && [ -s "$WALLPAPER" ] && plasma-apply-wallpaperimage "$WALLPAPER" >/dev/null; then
	for key in Image PreviewImage; do
		kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General \
			--key "$key" "file://$WALLPAPER"
	done
	mkdir -p "$STATE" && touch "$STATE/the-script-plasma-wallpaper-3"
fi
if [ ! -e "$STATE/the-script-plasma-cursor-3" ] && plasma-apply-cursortheme Adwaita-cursors >/dev/null; then
	mkdir -p "$STATE" && touch "$STATE/the-script-plasma-cursor-3"
fi

# Once: the search. Meta opens KRunner in the middle of the screen, Spotlight-style (so do Alt+Space and
# typing on the desktop); the menu is on the Arch logo and Alt+F1, and its search uses the same plugins.
# Apps, settings and the calculator come first; files, windows, places and recent documents follow, and
# anything else offers a DuckDuckGo search. Baloo indexes only the names of files in Desktop, Documents,
# Music, Pictures and Videos, not what is in them, so code, logs and unpacked downloads don't fill the
# results. The runners for KWin's console, the Plasma script console, shortcuts, help pages and Discover
# (not installed) are off.
if [ ! -e "$STATE/the-script-plasma-search-4" ]; then
	k() { kwriteconfig6 --file krunnerrc "$@"; }
	k --group General --key FreeFloating true
	k --group General --key ActivateWhenTypingOnDesktop true
	k --group General --key historyBehavior CompletionSuggestion
	k --group Plugins --group Favorites --key plugins krunner_services,krunner_systemsettings,calculator
	for r in krunner_kwin krunner_plasma-desktop krunner_keys helprunner krunner_appstream; do
		k --group Plugins --key "${r}Enabled" false
	done
	kwriteconfig6 --file baloofilerc --group General --key folders \
		"$(printf "$HOME/%s/," Desktop Documents Music Pictures Videos | sed 's/,$//')"
	kwriteconfig6 --file baloofilerc --group General --key "only basic indexing" true
	balooctl6 purge >/dev/null 2>&1   # drop the old index of everything; it rebuilds by itself
	kwriteconfig6 --file kuriikwsfilterrc --group General --key DefaultWebShortcut duckduckgo
	# Meta on its own is a global shortcut like any other: taken from the menu, given to KRunner.
	keys plasmashell 'activate application launcher' 150994992              # Alt+F1
	keys org.kde.krunner.desktop _launch 16777250 134217760 150994993 16777362   # Meta, Alt+Space, Alt+F2, Search
	# search-2 tried this through kwinrc, which Plasma 6 ignores.
	kwriteconfig6 --file kwinrc --group ModifierOnlyShortcuts --key Meta --delete
	pkill -x krunner   # D-Bus starts it again with the new settings
	mkdir -p "$STATE" && touch "$STATE/the-script-plasma-search-4"
fi

# The tray shows the volume, network, notifications, battery and apps running in the background (and the
# camera, a plugged-in drive or playing media while there is one); the microphone indicator and the
# rest are behind its arrow. The clock's text is about 15 px instead of filling the panel's height.
# The menu (the Arch logo) switches categories on hover, has no green dots on newly installed apps and icon-only
# Sleep, Restart and Shut Down buttons (named in their tooltips) with Lock next to them.
# Plasma only reads these at start, so the shell is restarted.
# The clock turns its point size into pixels by the screen's physical DPI, not by Plasma's scale, so 12 pt
# is 15 px on a 24" 1080p monitor but 21 px on a T14's 14" 1920x1200 screen. This gives the point size
# that comes out at about 15 px on the main screen (12 if its size is unknown).
clock_points() {
	kscreen-doctor -j 2>/dev/null | python3 -c 'import json, sys
outs = [o for o in json.load(sys.stdin)["outputs"] if o.get("enabled")]
outs.sort(key=lambda o: o.get("priority") or 99)
pt = 12
if outs and outs[0].get("sizeMM", {}).get("width"):
    o = outs[0]
    mode = next(m for m in o["modes"] if m["id"] == o["currentModeId"])
    dpi = mode["size"]["width"] / o.get("scale", 1) / (o["sizeMM"]["width"] / 25.4)
    pt = max(6, round(15 * 72 / dpi))
print(pt)' 2>/dev/null || echo 12
}
TRAY_HIDDEN=plasmashell_microphone,org.kde.plasma.clipboard,org.kde.plasma.bluetooth,org.kde.kscreen,org.kde.plasma.brightness,org.kde.plasma.keyboardlayout,org.kde.plasma.manage-inputmethod,org.kde.plasma.mediacontroller,org.kde.plasma.dwellclicker
tidy_tray() {
	local panel tray clock kickoff
	read -r panel tray clock kickoff < <(js 'var p = panels()[0]; var t = p.widgets("org.kde.plasma.systemtray")[0];
		var c = p.widgets("org.kde.plasma.digitalclock")[0]; var k = p.widgets("org.kde.plasma.kickoff")[0];
		print(p.id + " " + t.id + " " + (c ? c.id : "-") + " " + (k ? k.id : "-"));')
	local size; size=$(clock_points)
	sleep 2   # let the shell save what it was just told
	systemctl --user stop plasma-plasmashell
	kwriteconfig6 --file "$APPLETSRC" --group Containments --group "$panel" --group Applets \
		--group "$tray" --group General --key hiddenItems "$TRAY_HIDDEN"
	# The clock's default weight, 50, is from Qt 5's scale: in Qt 6 it is thinner than Thin.
	local key
	for key in autoFontAndSize=false fontSize="$size" fontWeight=400; do
		[ "$clock" != - ] && kwriteconfig6 --file "$APPLETSRC" --group Containments --group "$panel" --group Applets \
			--group "$clock" --group Configuration --group Appearance --key "${key%=*}" "${key#*=}"
	done
	for key in switchCategoryOnHover=true highlightNewlyInstalledApps=false showActionButtonCaptions=false \
		systemFavorites=lock-screen,suspend,reboot,shutdown; do
		[ "$kickoff" != - ] && kwriteconfig6 --file "$APPLETSRC" --group Containments --group "$panel" --group Applets \
			--group "$kickoff" --group Configuration --group General --key "${key%%=*}" "${key#*=}"
	done
	systemctl --user start plasma-plasmashell
	mkdir -p "$STATE" && touch "$STATE/the-script-plasma-tray-5"
}

# The panel is made on the first start of the shell; wait for it (and its tray).
for _ in $(seq 60); do
	tray=$(js 'var p = panels()[0]; var t = p ? p.widgets("org.kde.plasma.systemtray")[0] : null; print(t ? t.id : "");' 2>/dev/null)
	[ -n "$tray" ] && break
	sleep 1
done
[ -n "$tray" ] || { echo "the-script-plasma: no panel with a system tray" >&2; exit 1; }

# Once: the taskbar rebuilt in this layout. Rearranging it afterwards is kept (until the -N in the state
# file name is bumped). Widgets added by a script don't read the settings it writes (the logo, the pinned
# apps) until the shell restarts, which tidy_tray does.
if [ ! -e "$STATE/the-script-plasma-panel-1" ]; then
	keys kwin 'Edit Tiles'   # Meta+T by default
	js 'var old = panels()[0];
		if (old) old.remove();
		var p = new Panel;
		p.location = "bottom";
		p.height = 44;
		p.floating = true;
		p.opacity = "adaptive";
		var k = p.addWidget("org.kde.plasma.kickoff");
		k.currentConfigGroup = ["General"];
		k.writeConfig("icon", "/usr/share/pixmaps/archlinux-logo.svg");
		var tasks = p.addWidget("org.kde.plasma.icontasks");
		tasks.currentConfigGroup = ["General"];
		tasks.writeConfig("launchers", "'"$PINNED"'");
		p.addWidget("org.kde.plasma.panelspacer");
		p.addWidget("local.todo").globalShortcut = "Meta+T";
		p.addWidget("org.kde.plasma.systemtray");
		p.addWidget("org.kde.plasma.digitalclock");' >/dev/null \
		&& mkdir -p "$STATE" && touch "$STATE/the-script-plasma-panel-1" "$STATE/the-script-plasma-pins-1"
	tidy_tray
	exit 0   # the todo widget is already in place
fi
# The first version of that set the logo by name, which no icon theme has, so the button was blank.
js 'panels().forEach(function (p) {
		p.widgets("org.kde.plasma.kickoff").forEach(function (k) {
			k.currentConfigGroup = ["General"];
			if (k.readConfig("icon", "") == "archlinux-logo") {
				k.writeConfig("icon", "/usr/share/pixmaps/archlinux-logo.svg");
			}
		});
	});' >/dev/null

[ -e "$STATE/the-script-plasma-tray-5" ] || { tidy_tray; exit 0; }

# Once, on taskbars built before $PINNED: they kept Plasma's default pins, Discover's blank icon among
# them. Pins rearranged by hand (no Discover in them) are left alone. Plasma reads them only at start.
if [ ! -e "$STATE/the-script-plasma-pins-1" ]; then
	read -r panel tasks < <(js 'var p = panels()[0]; var t = p.widgets("org.kde.plasma.icontasks")[0];
		if (t) t.currentConfigGroup = ["General"];
		print(t && t.readConfig("launchers", "").indexOf("org.kde.discover") >= 0 ? p.id + " " + t.id : "");')
	if [ -n "${tasks:-}" ]; then
		systemctl --user stop plasma-plasmashell
		kwriteconfig6 --file "$APPLETSRC" --group Containments --group "$panel" --group Applets \
			--group "$tasks" --group Configuration --group General --key launchers "$PINNED"
		systemctl --user start plasma-plasmashell
	fi
	mkdir -p "$STATE" && touch "$STATE/the-script-plasma-pins-1"
fi

# The todo widget. Plasma reads the panel's order only at start, so a new one is moved left of the
# tray with the shell stopped. local.niritodo is its name from before the-script.
if [ -z "$(js 'print(panels()[0].widgets("local.todo").length || "");')" ]; then
	keys kwin 'Edit Tiles'   # Meta+T by default
	read -r panel todo ids < <(js 'var p = panels()[0];
		p.widgets("local.niritodo").forEach(function (w) { w.remove(); });
		var w = p.addWidget("local.todo"); w.globalShortcut = "Meta+T";
		print(p.id + " " + w.id + " " + p.widgetIds.join(";"));')
	sleep 2   # let the shell save the new widget
	systemctl --user stop plasma-plasmashell
	# A panel never rearranged has no saved order yet: then it is the order the widgets were added in.
	order=$(kreadconfig6 --file "$APPLETSRC" --group Containments --group "$panel" --group General --key AppletOrder)
	order=${order:-$ids}
	order=$(python3 -c 'import sys
o, todo, tray, live = sys.argv[1].split(";"), sys.argv[2], sys.argv[3], sys.argv[4].split(";")
o = [i for i in o if i in live and i != todo]
o.insert(o.index(tray) if tray in o else len(o), todo)
print(";".join(o))' "$order" "$todo" "$tray" "$ids")
	kwriteconfig6 --file "$APPLETSRC" --group Containments --group "$panel" --group General --key AppletOrder "$order"
	systemctl --user start plasma-plasmashell
fi
