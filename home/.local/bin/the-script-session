#!/usr/bin/env bash
#
# the-script-session: started by Hyprland at login (~/.config/hypr/hyprland.lua). Sets up the screens,
# then starts the desktop's parts: the bar/overview (Quickshell), notifications (mako), the idle lock
# (hypridle), password prompts (hyprpolkitagent), the network and Bluetooth tray icons, the to-do
# daemon, and the services that wait for a graphical session (bedtime, history-cleaner).
# Output goes to ~/.cache/the-script-session.log.

exec >"$HOME/.cache/the-script-session.log" 2>&1
B="$HOME/.local/bin"

# Screens first, so everything below starts at the right scale.
"$B/the-script-displays" || echo "the-script-displays failed"

# Steam (an X11 app) isn't scaled by Hyprland (xwayland.force_zero_scaling, so games stay sharp), so it
# scales its own window to the largest screen scale.
scale=$(hyprctl monitors -j | python3 -c 'import json,sys; print(max([m["scale"] for m in json.load(sys.stdin)] or [1]))')
export STEAM_FORCE_DESKTOPUI_SCALING="$scale"
hyprctl eval "hl.env(\"STEAM_FORCE_DESKTOPUI_SCALING\", \"$scale\")" >/dev/null

# GTK 4 apps and the file picker read "dark" from here.
gsettings set org.gnome.desktop.interface color-scheme prefer-dark
gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
gsettings set org.gnome.desktop.interface icon-theme Adwaita
gsettings set org.gnome.desktop.interface cursor-theme Adwaita
gsettings set org.gnome.desktop.interface font-name 'Adwaita Sans 11'

# Apps started by D-Bus and systemd find this session; then the services that wait for one.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
	HYPRLAND_INSTANCE_SIGNATURE QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM XCURSOR_THEME XCURSOR_SIZE \
	ELECTRON_OZONE_PLATFORM_HINT MOZ_ENABLE_WAYLAND STEAM_FORCE_DESKTOPUI_SCALING
systemctl --user restart the-script-session.target &
systemctl --user start hyprpolkitagent.service &

# The bar and overview; started again if it ever crashes.
( while true; do qs >"$HOME/.cache/quickshell.log" 2>&1; sleep 2; done ) &
mako &
hypridle &
nm-applet --indicator &
blueman-applet &
pgrep -f '/\.local/bin/todo daemon' >/dev/null || "$B/todo" daemon &
"$B/steam-overlay-scale" &
"$B/the-script-login" &
wait
