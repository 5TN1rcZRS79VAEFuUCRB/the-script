#!/usr/bin/env python3
"""todo-count: the LXQt panel's to-do button (custom command, structured output).

Shows an icon and "TODAY · WEEK": how many to-dos are due today (late ones included) and within
the next 7 days. While a focus session runs it shows the countdown instead. The tooltip names the
next task. Counts come from `todo json` and are cached for 30 s (the panel runs this every second).
"""
import base64, json, os, re, subprocess, time

RUN = os.environ.get("XDG_RUNTIME_DIR", os.path.expanduser("~/.cache"))
CACHE = os.path.join(RUN, "todo-count")
UNIT = {"m": 60, "h": 3600, "d": 86400, "w": 604800}

def b64(s):
    return base64.b64encode(s.encode()).decode()

def emit(text, icon, tip):
    print(f"text:{b64(text)} icon:{b64(icon)} tooltip:{b64(tip)}")

now = time.time()
# Focus/break countdown, written by `todo` ("END ICON TEXT")
try:
    end, _icon, *rest = open(os.path.join(RUN, "todo-focus")).read().split(maxsplit=2)
    left = int(end) - int(now)
    if left > 0:
        emit(f"{left // 60}:{left % 60:02d}", "appointment-soon", " ".join(rest) or "Focus session")
        raise SystemExit
except (OSError, ValueError):
    pass

try:
    if now - os.path.getmtime(CACHE) < 30:
        print(open(CACHE).read().strip())
        raise SystemExit
except OSError:
    pass

def secs(left):
    return sum(int(n) * UNIT.get(u, 0) for n, u in re.findall(r"(\d+)\s*([mhdw])", left or ""))

try:
    m = json.loads(subprocess.run([os.path.expanduser("~/.local/bin/todo"), "json"],
                                  capture_output=True, text=True, timeout=20).stdout)
except Exception:
    emit("?", "task-due", "To-do couldn't load")
    raise SystemExit

midnight = time.mktime(time.localtime(now)[:3] + (23, 59, 59, 0, 0, -1))
today = week = 0
for t in m.get("tasks", []):
    s = 0 if t.get("late") else secs(t.get("left"))
    if t.get("late") or now + s <= midnight:
        today += 1
    if t.get("late") or s < 7 * 86400:
        week += 1
tasks = m.get("tasks", [])
nxt = f"\nNext: {tasks[0]['title']} ({tasks[0]['left']})" if tasks else "\nAll caught up"
tip = f"{today} due today, {week} in the next 7 days{nxt}\n{m.get('pts', 0)} points, {m.get('streak', 0)}-day streak\nClick or Super+T for the list"
line = f"text:{b64(f'{today} · {week}')} icon:{b64('task-due')} tooltip:{b64(tip)}"
with open(CACHE + ".tmp", "w") as f:
    f.write(line + "\n")
os.replace(CACHE + ".tmp", CACHE)
print(line)
