[Desktop Entry]
# Replaces KeePassXC's own entry so it runs through X11 (XWayland): GNOME then draws its title bar
# like other apps' (square, from gtk.css) instead of Qt's rounded Adwaita-style one on Wayland.
Name=KeePassXC
GenericName=Password Manager
Comment=Community-driven port of the Windows application “KeePass Password Safe”
Exec=env QT_QPA_PLATFORM=xcb keepassxc %f
TryExec=keepassxc
Icon=keepassxc
StartupWMClass=keepassxc
StartupNotify=false
Terminal=false
Type=Application
Version=1.5
Categories=Utility;Security;Qt;
MimeType=application/x-keepass2;
SingleMainWindow=true
X-GNOME-SingleWindow=true
Keywords=security;privacy;password-manager;yubikey;password;keepass;
