/* ClassicDark — old-school beveled dark panel (made 2026-11-11) */
LXQtPanel #BackgroundWidget {
    background: #3c3c3c;
    border-top: 1px solid #5a5a5a;
}
QToolTip { background: #262626; color: #e0e0e0; border: 1px solid #5a5a5a; padding: 2px; }

/* raised button: light top-left, dark bottom-right */
#MainMenu, #TaskBar QToolButton {
    background: #3c3c3c;
    color: #e0e0e0;
    border-style: solid;
    border-width: 2px;
    border-color: #6a6a6a #141414 #141414 #6a6a6a;
    padding: 0px 4px;
    margin: 2px 1px;
}
#MainMenu { font-weight: bold; padding: 0px 6px; margin-left: 2px; qproperty-icon: url(mainmenu.svg); }
#TaskBar QToolButton { text-align: left; }
#TaskBar QToolButton:hover { background: #444444; }
/* sunken: the active window and pressed buttons */
#MainMenu:pressed, #TaskBar QToolButton:on, #TaskBar QToolButton:pressed {
    background: #2e2e2e;
    border-color: #141414 #6a6a6a #6a6a6a #141414;
    font-weight: bold;
}
#TaskBar QToolButton[urgent="true"] { background: #1f4a8a; color: #ffffff; }

#QuickLaunch QToolButton { border: 1px solid transparent; padding: 1px; }
#QuickLaunch QToolButton:hover { border-color: #6a6a6a #141414 #141414 #6a6a6a; }
#QuickLaunch QToolButton:pressed { border-color: #141414 #6a6a6a #6a6a6a #141414; }

/* Right side: each item is a raised button, like the taskbar buttons */
#StatusNotifierPlugin, #CustomPlugin, #WorldClockPlugin { background: transparent; border: none; margin: 0px; }
#CustomPlugin QToolButton, #StatusNotifier QToolButton, #WorldClock {
    background: #3c3c3c;
    border-style: solid;
    border-width: 2px;
    border-color: #6a6a6a #141414 #141414 #6a6a6a;
    padding: 0px 6px;
    margin: 2px 1px;
}
#StatusNotifier QToolButton { padding: 0px 3px; }
#CustomPlugin QToolButton { padding: 0px 0px 0px 9px; }
#CustomPlugin QToolButton:hover, #StatusNotifier QToolButton:hover, #WorldClock:hover { background: #444444; }
#CustomPlugin QToolButton:pressed, #StatusNotifier QToolButton:pressed {
    background: #2e2e2e;
    border-color: #141414 #6a6a6a #6a6a6a #141414;
}
#WorldClock { margin-right: 3px; }
#WorldClockContent { padding: 0px 6px 0px 4px; }

QMenu { background: #3c3c3c; color: #e0e0e0; border-style: solid; border-width: 2px; border-color: #6a6a6a #141414 #141414 #6a6a6a; }
QMenu::item { padding: 3px 20px 3px 8px; }
QMenu::item:selected { background: #1f4a8a; color: #ffffff; }
QMenu::item:disabled { color: #808080; }
QMenu::separator { height: 2px; margin: 3px 2px; border-top: 1px solid #1a1a1a; border-bottom: 1px solid #5a5a5a; }
QMenu::icon { padding-left: 4px; }

#Spacer { background-position: center center; }
