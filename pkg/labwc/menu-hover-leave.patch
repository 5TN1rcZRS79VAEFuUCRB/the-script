+/*
+ * Pointer left the menu items: clear the highlighted item, except one whose
+ * submenu is open (it stays lit, like in Qt and GTK menus).
+ */
+void
+menu_process_cursor_leave(void)
+{
+	struct menu *menu = get_selection_leaf();
+	if (menu && menu->selection.item && !menu->selection.menu) {
+		menu_set_selection(menu, NULL);
+	}
+}
