+// Local patch: on Wayland, anchor a tray menu to its icon so it opens above the panel. Qt doesn't
+// know where the panel is on screen, so the plain popup() position ends up over the taskbar.
+static void anchorTrayMenu(QMenu *menu, QWidget *button, ILXQtPanel *panel)
+{
+    if (!qGuiApp->nativeInterface<QNativeInterface::QWaylandApplication>())
+        return;
+    menu->winId();
+    QWindow *menuWindow = menu->windowHandle();
+    if (!menuWindow)
+        return;
+    const QRect anchorRect(button->mapTo(button->window(), QPoint(0, 0)), button->size());
+    const bool bottom = panel->position() == ILXQtPanel::PositionBottom;
+    menuWindow->setProperty("_q_waylandPopupAnchorRect", anchorRect);
+    menuWindow->setProperty("_q_waylandPopupAnchor",
+        QVariant::fromValue(Qt::Edges((bottom ? Qt::TopEdge : Qt::BottomEdge) | Qt::RightEdge)));
+    menuWindow->setProperty("_q_waylandPopupGravity",
+        QVariant::fromValue(Qt::Edges((bottom ? Qt::TopEdge : Qt::BottomEdge) | Qt::LeftEdge)));
+}
