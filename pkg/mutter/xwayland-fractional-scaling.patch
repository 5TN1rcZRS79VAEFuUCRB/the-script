+static MtkRegion *
+region_scale_float (MtkRegion *region,
+                    float      scale)
+{
+  graphene_matrix_t matrix;
+
+  if (G_APPROX_VALUE (scale, roundf (scale), FLT_EPSILON))
+    return mtk_region_scale (region, (int) roundf (scale));
+  if (scale < 1.0f &&
+      G_APPROX_VALUE (1.0f / scale, roundf (1.0f / scale), FLT_EPSILON))
+    return mtk_region_downscale (region, (int) roundf (1.0f / scale));
+
+  graphene_matrix_init_scale (&matrix, scale, scale, 1.0f);
+  return mtk_region_apply_matrix_transform_expand (region, &matrix);
+}
