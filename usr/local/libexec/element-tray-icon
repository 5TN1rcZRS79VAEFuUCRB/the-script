#!/usr/bin/env python3
#
# element-tray-icon: shrinks Element's tray icon (/usr/lib/element/build/icon.png, a filled circle edge to
# edge) to 80% with a clear border, so it is no bigger in the tray than Steam's and Plasma's icons. Run by
# install.sh and, after each Element update, by /etc/pacman.d/hooks/element-tray-icon.hook.

from PIL import Image

ICON = "/usr/lib/element/build/icon.png"
SCALE = 0.8

im = Image.open(ICON).convert("RGBA")
w, h = im.size
box = im.getchannel("A").getbbox()
if box and box[2] - box[0] > w * 0.9:  # not shrunk yet
    small = im.resize((round(w * SCALE), round(h * SCALE)), Image.LANCZOS)
    out = Image.new("RGBA", (w, h))
    out.paste(small, ((w - small.width) // 2, (h - small.height) // 2))
    out.save(ICON)
