#!/usr/bin/env python3
#
# settings-pointer-speed: starts GNOME Settings with its pointer speed sliders showing their value,
# -1.00 to 1.00, like the volume and brightness percentages, and a Razer or Endgame Gear mouse's DPI
# under the mouse slider. Settings' Mouse & Touchpad page (cc-mouse-panel.ui) is built into the program;
# a copy with those changes is made from it at each start, so it always matches the program, and
# G_RESOURCE_OVERLAYS makes Settings load the copy. If anything fails, Settings starts with its own page.
# Started by ~/.local/share/dbus-1/services/org.gnome.Settings.service, so only Settings gets the
# variable: GLib logs a line in every program that has it.

import fcntl
import glob
import os
import re
import sys
import time

from gi.repository import Gio, GLib

PROGRAM = "/usr/bin/gnome-control-center"
PAGE = "/org/gnome/control-center/mouse/cc-mouse-panel.ui"
SHOW_VALUE = ('<property name="draw-value">true</property><property name="digits">2</property>'
              '<property name="value-pos">right</property>')


def page():
    # The program's resource bundles are embedded whole; each starts with GVDB's "GVariant" signature.
    data = open(PROGRAM, "rb").read()
    at = data.find(b"GVariant")
    while at != -1:
        try:
            res = Gio.Resource.new_from_data(GLib.Bytes.new(data[at:]))
            return res.lookup_data(PAGE, Gio.ResourceLookupFlags.NONE).get_data().decode()
        except GLib.Error:
            at = data.find(b"GVariant", at + 1)
    raise LookupError(f"{PAGE} not found in {PROGRAM}")


# DPI as the mouse itself reports it over hidraw. Razer: Razer's 90-byte feature report, get DPI =
# class 0x04, id 0x85. Endgame Gear 8k (OP1 8k v2 etc.): LOAD (0x12) on report 0xA1, then report
# 0xA0 returns the 1024-byte settings block at offset 16 (layout from github.com/Janlhin/
# Endgame_Gear_Web_Configurator). Both are read-only. None for other mice or a sleeping wireless one.
# Opening /dev/hidraw* without root needs /etc/udev/rules.d/70-mouse-dpi.rules.
def feature(n, size):
    return (3 << 30) | (size << 16) | (ord('H') << 8) | n  # HIDIOCSFEATURE(6)/HIDIOCGFEATURE(7)


def dpi_text(x, y):
    return str(x) if x == y else f"{x}x{y}"


def razer(fd):
    for tid in (0x1f, 0x3f, 0xff):  # transaction id differs between Razer models
        r = bytearray(91)  # report number 0, then the 90-byte report
        r[2], r[6], r[7], r[8] = tid, 0x07, 0x04, 0x85
        for b in r[3:89]:
            r[89] ^= b
        fcntl.ioctl(fd, feature(6, 91), bytes(r))
        time.sleep(0.06)
        fcntl.ioctl(fd, feature(7, 91), r)
        if r[1] == 0x02 and r[7:9] == b'\x04\x85':  # status 2 = ok
            return dpi_text(r[10] << 8 | r[11], r[12] << 8 | r[13])


def endgame(fd):
    cmd = bytearray(64)
    cmd[0], cmd[1] = 0xA1, 0x12
    fcntl.ioctl(fd, feature(6, 64), bytes(cmd))
    for _ in range(5):
        time.sleep(0.08)
        r = bytearray(1041)
        r[0] = 0xA0
        fcntl.ioctl(fd, feature(7, 1041), r)
        b = r[16:]
        if r[1] == 0x01 and b[0x0D] < b[0x0E] <= 4:  # status 1 = ok; active stage < stage count
            o = 0x23 + 5 * b[0x0D]  # per stage: [separate Y flag][X u16 LE][Y u16 LE]
            x = b[o + 1] | b[o + 2] << 8
            return dpi_text(x, b[o + 3] | b[o + 4] << 8 if b[o] else x)


def dpi():
    for node in glob.glob('/sys/class/hidraw/hidraw*'):
        try:
            uevent = open(node + '/device/uevent').read()
            if ':00001532:' in uevent:
                read = razer
            elif ':00003367:' in uevent and b'\x85\xa0' in open(node + '/device/report_descriptor', 'rb').read():
                read = endgame  # only the interface that has the config reports
            else:
                continue
            fd = os.open('/dev/' + os.path.basename(node), os.O_RDWR)
            try:
                found = read(fd)
            finally:
                os.close(fd)
            if found:
                return found
        except OSError:
            continue  # no access, or not the control interface


def overlay():
    ui, n = re.subn(r'(<object class="GtkScale" id="(?:mouse|touchpad|pointingstick)_speed_scale">)',
                    r"\1" + SHOW_VALUE, page())
    if not n:
        raise LookupError("no pointer speed sliders in the page")
    found = dpi()
    if found:
        ui = ui.replace('<object class="AdwActionRow" id="mouse_row">',
                        f'<object class="AdwActionRow" id="mouse_row"><property name="subtitle">{found} DPI</property>', 1)
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or GLib.get_user_runtime_dir(), "the-script-cc-mouse-panel.ui")
    with open(path + ".tmp", "w") as f:
        f.write(ui)
    os.replace(path + ".tmp", path)
    return path


env = dict(os.environ)
try:
    env["G_RESOURCE_OVERLAYS"] = f"{PAGE}={overlay()}"
except (OSError, LookupError, UnicodeError) as e:
    print(f"settings-pointer-speed: {e}; Settings keeps its own sliders", file=sys.stderr)
os.execve(PROGRAM, [PROGRAM, *sys.argv[1:]], env)
