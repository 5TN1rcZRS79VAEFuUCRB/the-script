#!/usr/bin/env python3
#
# the-script-blocklist: blocks porn sites for every program on this machine by pointing them at
# 0.0.0.0 in /etc/hosts. The list is StevenBlack's porn-only hosts file (about 77,000 sites), plus
# the few in /usr/local/share/the-script/blocked-hosts that it misses. Run by install.sh and daily by
# the-script-blocklist.timer. If the download fails, the last good copy is used. Lines of yours in
# /etc/hosts outside the "the-script blocklist" block are kept.

import os
import re
import urllib.request

URL = "https://raw.githubusercontent.com/StevenBlack/hosts/master/alternates/porn-only/hosts"
CACHE = "/var/lib/the-script/blocklist-hosts"
EXTRA = "/usr/local/share/the-script/blocked-hosts"
HOSTS = "/etc/hosts"
BEGIN = "# >>> the-script blocklist (managed by the-script-blocklist; edits here are replaced)"
END = "# <<< the-script blocklist"

NAME = re.compile(r"^[a-z0-9_-]+(\.[a-z0-9_-]+)+$")
KEEP = {"localhost", "localhost.localdomain", "local", "broadcasthost", "0.0.0.0"}


def names(text):
    """Hostnames from a hosts file or a plain one-per-line list."""
    out = set()
    for line in text.splitlines():
        parts = line.split("#", 1)[0].split()
        if len(parts) >= 2 and parts[0] in ("0.0.0.0", "127.0.0.1"):
            parts = parts[1:]
        for p in parts:
            p = p.lower().rstrip(".")
            if NAME.match(p) and p not in KEEP and not p.replace(".", "").isdigit():
                out.add(p)
    return out


def write(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        f.write(text)
    os.chmod(path + ".tmp", mode)
    os.replace(path + ".tmp", path)


try:
    with urllib.request.urlopen(URL, timeout=60) as r:
        fresh = r.read().decode("utf-8", "replace")
    if len(names(fresh)) < 10000:
        raise ValueError("downloaded list is suspiciously short")
    write(CACHE, fresh)
except Exception as e:
    print(f"the-script-blocklist: could not download the list ({e}); using the last good copy")

def read(path):
    try:
        with open(path) as f:
            return names(f.read())
    except FileNotFoundError:
        return set()


extra = read(EXTRA)
blocked = read(CACHE) | extra
for n in extra:  # cover both example.com and www.example.com
    blocked.add(n[4:] if n.startswith("www.") else "www." + n)

with open(HOSTS) as f:
    current = f.read()
mine = re.sub(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", "", current, flags=re.S).rstrip("\n")

block = "\n".join(f"0.0.0.0 {n}" for n in sorted(blocked))
write(HOSTS, f"{mine}\n\n{BEGIN}\n{block}\n{END}\n")
print(f"the-script-blocklist: {len(blocked)} sites blocked in {HOSTS}")
